{
  "name": "cyberstriker-quantum-arena",
  "private": true,
  "description": "2D competitive arena fighter built with HTML5 Canvas",
  "scripts": {
    "build": "esbuild js/app.js --bundle --format=iife --outfile=js/bundle.js",
